# Optional for fallback-only local development; required for production discovery.
GITHUB_TOKEN=

# Required for install-event ingestion. Generate a stable value with:
# openssl rand -hex 32
INSTALL_CLIENT_HASH_SECRET=

# Required for POST /api/v1/catalog/sync (GitHub CI curated-catalog reconciliation).
# Generate with: openssl rand -hex 32
CATALOG_SYNC_TOKEN=

# Required for GitHub sign-in on the developer API portal (/account, /docs/api).
# Create a GitHub OAuth App whose callback URL is
# https://<site>/api/v1/auth/github/callback (use a second app pointing at
# http://localhost:<port>/api/v1/auth/github/callback for local dev).
# NOTE: wrangler lists these as required secrets — set both with
# `wrangler secret put` before the next production deploy.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Absolute origin for the plugin API when the frontend is served from another host,
# e.g. https://example.com. Leave empty for the same-origin default.
VITE_API_ORIGIN=

# Set to true when the bundle is served inside a mobile webview container that
# may swallow target=_blank: catalog rows then navigate in the same tab instead
# of opening a new one.
VITE_ROW_LINKS_SAME_TAB=

# Set to true in an embedded build that ships the catalog as a standalone shell
# with no room for the discussion section: the community nav entry is dropped.
VITE_HIDE_COMMUNITY=
